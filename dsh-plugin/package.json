{
  "name": "dsh-agents-playbook",
  "version": "0.7.0",
  "description": "DeepSeek Harness plugin for Agent-Playbook: multi-agent claims, isolated git worktrees, and enforced acceptance checks. \"Done\" is an exit code, not a claim.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./core": "./core.mjs",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "core.mjs",
    "cordis.patch.yml",
    "README.md",
    "engine/"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "agent-playbook",
    "agent",
    "worktree",
    "multi-agent",
    "acceptance-checks"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/riverho/agents-playbook.git",
    "directory": "dsh-plugin"
  },
  "homepage": "https://github.com/riverho/agents-playbook#readme",
  "bugs": {
    "url": "https://github.com/riverho/agents-playbook/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "prepack": "node ../scripts/pack-dsh-plugin.mjs"
  },
  "dependencies": {
    "js-yaml": "^4.1.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-agent": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-llm": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-tools": "^0.1.5-rc.2",
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "engines": {
    "node": ">=18"
  }
}

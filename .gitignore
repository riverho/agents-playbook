# docs/ is local scratch by default. Published contracts are opt-in — list them
# below. Must be `docs/*`, not `docs/`: git cannot re-include a file whose parent
# directory is excluded.
docs/*
!docs/wenmei-pb-integration-contract.md
.wenmei/
.wenmei/*
node_modules/
dist/
*.log
.DS_Store
.agents-playbook/

# OpenCode adapter sandbox (vendored node_modules; not engine source)
.opencode/

# The DSH plugin's bundled engine is GENERATED at publish time from this repo
# (`npm run build:plugin`). Committing it would put a second copy of the engine in
# the tree, free to drift from the one that is actually tested.
dsh-plugin/engine/

# The DSH Client plugin bundle (the Flow room as a Harness panel) is GENERATED too, from
# apps/flow-room/src/dsh/client.ts by `npm run build:client` (also run by dsh-plugin's
# prepack). Same reason as engine/: a committed bundle is a second copy free to drift.
dsh-plugin/client.js

# The bundle's content stamp: records WHICH sources produced the current bundle so a source
# edit without a version bump rebuilds instead of shipping stale files. Generated, and kept
# outside engine/ so it is never published.
dsh-plugin/.bundle-stamp

# The plugin is a second npm package, so `npm install` inside it writes its own
# lockfile. Nothing needs it versioned: the plugin declares exactly one real
# dependency, and a committed lock would also pin the harness PEER versions, which
# are the deployment's business, not the plugin's. Left untracked it is regenerated
# on demand; left ignored it cannot be swept into a release by `git add -A`.
dsh-plugin/package-lock.json

# Local-only files
2026-06-10-234302-local-command-caveatcaveat-the-messages-below.txt
2026-06-10-235329-local-command-caveatcaveat-the-messages-below.txt
AGENTS.md
CLAUDE.md
SMOKE*.*
local*.*

# Code deliberately cut from the engine (old spec/workmap layer). Safe to delete.
attic/

# pb runtime state is LOCAL TRUTH, not source. A git-tracked journal/projection is
# reverted by merges (checkout/stash) and silently loses records — the engine's
# tracked-state guard refuses an honest `loop close --status done` while they are
# committed. `git rm -r --cached memory artifacts` untracked them; these rules keep
# them untracked. The files stay on disk and `pb` owns them.
memory/
artifacts/

# Probe scaffolding is generated per machine (scripts/probe-stop-gate.mjs writes a patch
# containing an absolute module specifier). Regenerated on demand, never committed.
artifacts/probe/
nul
